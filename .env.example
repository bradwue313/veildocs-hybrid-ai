# Copy to .env.local and fill in your Firebase Web App config.
# Firebase AI Logic must be enabled in the Firebase Console (AI Logic -> Get Started -> Gemini Developer API).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
